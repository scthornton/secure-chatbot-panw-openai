# ===========================================================================
# SECURE AI CHATBOT WITH OPENAI - ENVIRONMENT CONFIGURATION
# ===========================================================================
# 
# INSTRUCTIONS:
# 1. Copy this file to ".env" (without .example)
# 2. Fill in your actual API keys and configuration values
# 3. Never commit the .env file to version control (it contains secrets!)
#
# ===========================================================================

# =============================================================================
# PALO ALTO NETWORKS AI RUNTIME SECURITY CONFIGURATION
# =============================================================================

# API Key from Strata Cloud Manager
# Get this from: https://apps.paloaltonetworks.com/
# This is your secret authentication key for accessing Palo Alto's security services
PANW_AI_SEC_API_KEY=your_palo_alto_api_key_here

# Security Profile Name (configured in Strata Cloud Manager)
# This is the name of your AI Security Profile that defines your security rules
PANW_AI_SEC_PROFILE_NAME=your_security_profile_name

# API Endpoint (choose based on the region your API key was issued in)
# US:        https://service.api.aisecurity.paloaltonetworks.com
# EU:        https://service-de.api.aisecurity.paloaltonetworks.com
# India:     https://service-in.api.aisecurity.paloaltonetworks.com
# Singapore: https://service-sg.api.aisecurity.paloaltonetworks.com
PANW_AI_SEC_ENDPOINT=https://service.api.aisecurity.paloaltonetworks.com

# Scan metadata (optional). Shown in Strata Cloud Manager sessions and
# violations, so pick values you will recognize. app_user defaults to your
# OS username.
# PANW_AI_SEC_APP_NAME=secure-chatbot-openai
# PANW_AI_SEC_APP_USER=jane.doe

# =============================================================================
# OPENAI CONFIGURATION
# =============================================================================

# OpenAI API Key
# Get this from: https://platform.openai.com/api-keys
# This is your secret key for accessing OpenAI's GPT services
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI model ID (optional). Leave unset to use the code default.
# Note: gpt-3.5-turbo retires 2026-10-23, do not pin it.
# OPENAI_MODEL=gpt-4o-mini

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================
# The variables below are placeholders for your own extensions. The shipped
# code does not read them (timeouts are fixed at 30 seconds, retries at 3).

# Application Environment
ENVIRONMENT=development

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# =============================================================================
# SECURITY NOTES FOR YOUR CUSTOMER
# =============================================================================
# 
# 🔐 CRITICAL SECURITY REQUIREMENTS:
# 
# 1. NEVER commit this file with real credentials to version control
# 2. Add ".env" to your .gitignore file immediately
# 3. Use different .env files for different environments (dev, staging, prod)
# 4. Consider using enterprise secret management for production deployments
# 5. Rotate your API keys regularly (recommended: every 90 days)
# 6. Use minimum required permissions for your API keys
# 7. Monitor API key usage for suspicious activity
# 8. Store backup copies of this configuration in a secure location
#
# 🏢 ENTERPRISE DEPLOYMENT NOTES:
# 
# - For production deployments, consider using:
#   * Azure Key Vault
#   * AWS Secrets Manager  
#   * HashiCorp Vault
#   * Kubernetes Secrets
# 
# - Implement proper access controls and audit logging
# - Use infrastructure-as-code for consistent deployments
# - Set up monitoring and alerting for API failures
#
# =============================================================================